{
  "name": "@affect-kit/checkin",
  "version": "0.0.0",
  "private": true,
  "description": "Check-in: drag the face, say a few words, and see your feeling words. A reference app built on affect-kit.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "wrangler dev",
    "db:migrate": "wrangler d1 migrations apply checkin --local",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@affect-kit/checkin-core": "workspace:*",
    "@hono/zod-validator": "^0.9.1",
    "affect-kit": "workspace:*",
    "hono": "^4.13.13",
    "reflect-metadata": "^0.2.2",
    "tsyringe": "^4.10.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250507.0",
    "@playwright/test": "^1.48.0",
    "@sveltejs/adapter-cloudflare": "^7.2.9",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "typescript": "^5.7.0",
    "vite": "^7.3.2",
    "vitest": "^2.1.0",
    "wrangler": "^4.90.0"
  }
}
